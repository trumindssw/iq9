roopak@roopak-Latitude-3440:~/Documents/iq9/build-qcom-wayland/tmp-glibc/work/qcs9075_iq_9075_evk-qcom-linux/linux-qcom-custom/6.6/kernel/drivers/net/ethernet/stmicro/stmmac$ ls -l | grep stmmac.ko
-rw-r--r-- 1 roopak roopak 14719384 May 12 10:54 stmmac.ko

****************** Copy this .ko on to the device(Iq9) using wifi or ethernet ******************
scp stmmac.ko root@192.168.1.8:/root/

****************** Insert stmmac module in the device(Iq9) ******************
use below commands

echo "----- eth0 interface down"
ifconfig eth0 down

echo "----- Removing dependencies and modules"
rmmod dwmac_qcom_ethqos 
rmmod stmmac_platform 
rmmod stmmac 

echo "----- Insert New Module"
insmod stmmac.ko 

echo "----- Load Dependencies"
modprobe stmmac_platform 
modprobe dwmac_qcom_ethqos 

echo "----- Bring eth0 interface up"
ifconfig eth0 up
dmesg | tail -50 



Device lopgs with above command

